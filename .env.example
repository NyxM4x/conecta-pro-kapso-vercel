# Plantilla de variables de entorno. Copiar a .env.local y completar con valores reales.
# Ningún valor de acá es una clave de verdad.

# ---------------------------------------------------------------------------
# PROVEEDOR DE IA
# ---------------------------------------------------------------------------
# openai | openrouter. Si falta o no se reconoce, se usa openai.
# Volver a OpenAI es cambiar SOLO esta línea: no hay que tocar código.
AI_PROVIDER=openai

# --- opción A: OpenAI (por defecto) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# --- opción B: OpenRouter ---
# openrouter/free es un router que elige un modelo gratis al azar en cada llamada: sale 0,
# soporta salida estructurada e imágenes, pero es menos consistente con los textos exactos
# que exige el prompt. Para consistencia, fijar un modelo concreto (ej. openai/gpt-4o-mini).
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openrouter/free

# Transcripción de audios: NO depende de AI_PROVIDER, porque OpenRouter no tiene endpoint
# de transcripción. Con GROQ_API_KEY va primero por Groq (Whisper, cuota gratuita) y OpenAI
# queda de respaldo; sin esa clave va solo por OpenAI. Si ninguno puede (por ejemplo,
# OPENAI_API_KEY sin saldo), el bot le pide al cliente que escriba el mensaje en vez de
# adivinar.
GROQ_API_KEY=gsk_...
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# ---------------------------------------------------------------------------
# WHATSAPP (Kapso)
# ---------------------------------------------------------------------------
KAPSO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KAPSO_PHONE_NUMBER_ID=000000000000000

# ---------------------------------------------------------------------------
# SUPABASE
# ---------------------------------------------------------------------------
# Sin /rest/v1 al final: el cliente lo agrega solo y duplicarlo rompe todas las consultas.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# TELEGRAM (panel del equipo y alertas)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_CHAT_ID=-0000000000
TELEGRAM_DEV_CHAT_ID=0000000000
TELEGRAM_WEBHOOK_SECRET=cadena-larga-al-azar

# ---------------------------------------------------------------------------
# SECRETOS DE ENDPOINTS
# ---------------------------------------------------------------------------
# Protege /api/bot-control/* y /api/telegram/setup.
BOT_CONTROL_SECRET=cadena-al-azar
# Protegen /api/cron/unattended-leads: FOLLOWUP_SECRET viaja en X-Followup-Secret
# (lo usa el pg_cron de Supabase) y CRON_SECRET en Authorization: Bearer (Vercel Cron).
FOLLOWUP_SECRET=cadena-al-azar
CRON_SECRET=cadena-al-azar

# ---------------------------------------------------------------------------
# OPCIONALES (tienen valor por defecto en el código)
# ---------------------------------------------------------------------------
# Segundos que el bot espera desde el último mensaje del cliente antes de responder.
REPLY_WAIT_SECONDS=120
UNATTENDED_LEAD_THRESHOLD_MINUTES=30
UNATTENDED_LEAD_LOOKBACK_HOURS=24
UNATTENDED_LEAD_FINAL_ALERT_HOURS=20
CONECTA_PRO_MAPS_URL=https://maps.app.goo.gl/xxxxxxxx
CONECTA_PRO_LOCATION_VIDEO_URL=https://xxxxxxxx/video.mp4
# Número del WhatsApp de Conecta Pro, con código de país. Lo usan los botones que vuelven
# al chat desde /paquetes y /cursos; sin la variable esos botones no aparecen.
CONECTA_PRO_WHATSAPP=59170000000
# Dominio de las páginas /paquetes y /cursos para los botones que manda el bot. Sin ella se
# usa el dominio de producción que Vercel expone solo (VERCEL_PROJECT_PRODUCTION_URL), y si
# tampoco está, el de producción escrito en lib/site-links.ts. Opcional.
CONECTA_PRO_SITE_URL=https://conecta-pro-kapso-vercel-seven.vercel.app
# Firma el número del cliente en el link de /paquetes, para que el lead de la web se cierre
# también en su chat. Sin ella se firma con KAPSO_API_KEY.
LEAD_LINK_SECRET=cadena-larga-al-azar
